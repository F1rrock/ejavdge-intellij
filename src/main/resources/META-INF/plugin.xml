<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- Unique identifier of the plugin. It should be FQN. It cannot be changed between the plugin versions. -->
    <id>org.ejavdge.ejavdge</id>
    <name>EJavdge</name>
    <vendor>EJavdge</vendor>

    <!-- Description of the plugin displayed on the Plugin Page and IDE Plugin Manager.
         Simple HTML elements (text formatting, paragraphs, and lists) can be added inside of <![CDATA[ ]]> tag.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/plugin-overview-page.html#plugin-description -->
    <description><![CDATA[
        <p>Work with ejudge contests directly from IntelliJ IDEA.</p>
        <ul>
            <li>Browse available and solved problems in the contest.</li>
            <li>Read problem statements and download Local Test files.</li>
            <li>Run solutions against sample tests locally, before submitting.</li>
            <li>Submit source files with one action, with or without waiting for the report.</li>
            <li>Read the judge's report in a dedicated tool window.</li>
        </ul>
    ]]></description>

    <change-notes><![CDATA[
        <ul>
            <li>Run contest actions in the background and show failures in an EJavdge error dialog.</li>
            <li>Use Probed Submit to run samples before submitting the original source.</li>
            <li>Run samples with the problem's optional Java header and footer.</li>
            <li>Download Local Test files to the solution's Sources Root and run local checks from there.</li>
            <li>Fix problem attachment downloads and exclude Notes from expected sample output.</li>
        </ul>
    ]]></change-notes>

    <!-- Product and plugin compatibility requirements.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <depends>com.intellij.modules.platform</depends>

    <!-- Extension points defined by the plugin.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-extension-points.html -->
    <extensions defaultExtensionNs="com.intellij">
        <applicationConfigurable
                parentId="tools"
                instance="org.ejavdge.settings.EjSettings"
                displayName="EJavdge"/>
        <applicationService
                serviceImplementation="org.ejavdge.settings.EjState"/>
        <toolWindow
                id="EJavdge"
                anchor="bottom"
                icon="/icons/logo.png"
                factoryClass="org.ejavdge.widget.EjToolWindow"/>
    </extensions>
    <actions>
        <group
                id="EJavdge"
                text="EJavdge"
                popup="true"
                icon="/icons/logo.png">
            <add-to-group
                    group-id="ToolsMenu"
                    anchor="last"/>
            <add-to-group
                    group-id="MainToolBar"
                    anchor="last"/>
            <action
                    id="EJavdge.AvailableProblems"
                    class="org.ejavdge.action.ActOfAvailableProblems"
                    text="Available Problems"
                    description="Show available problem names for the current contest"/>
            <action id="EJavdge.AlreadySolved"
                    class="org.ejavdge.action.ActOfSolvedProblems"
                    text="Already Solved"
                    description="Show already solved problem names for the current contest"/>
            <action
                    id="EJavdge.ProblemDescription"
                    class="org.ejavdge.action.ActOfProblemDescription"
                    text="Problem Description"
                    description="Show description of current problem"/>
            <action id="EJavdge.LocalTestFilesDownload"
                    class="org.ejavdge.action.ActOfLocalTestFilesDownload"
                    text="Download Local Test Files"
                    description="Download the current problem's Local Test files"/>
            <action id="EJavdge.LocalProbe"
                    class="org.ejavdge.action.ActOfLocalProbe"
                    text="Local Probe"
                    description="Perform local testing of solution"/>
            <action id="EJavdge.LastReport"
                    class="org.ejavdge.action.ActOfLastReport"
                    text="Last Report"
                    description="Read the latest run's report, falling back to run information when the report is unavailable."/>
            <action id="EJavdge.SilentSubmit"
                    class="org.ejavdge.action.ActOfSilentSubmit"
                    text="Silent Submit"
                    description="Submit current file as solution"/>
            <action id="EJavdge.SubmitWithNotification"
                    class="org.ejavdge.action.ActOfSubmitWithNotification"
                    text="Submit With Notification"
                    description="Submit current file as solution and send a notification when report is available"/>
            <action id="EJavdge.ReportedSubmit"
                    class="org.ejavdge.action.ActOfReportedSubmit"
                    text="Reported Submit"
                    description="Submit current file as solution and display the resulting report"/>
            <action id="EJavdge.ProbedSubmit"
                    class="org.ejavdge.action.ActOfProbedSubmit"
                    text="Probed Submit"
                    description="Probe current file against local examples, then submit it as solution and display the resulting report"/>
        </group>
    </actions>
</idea-plugin>
